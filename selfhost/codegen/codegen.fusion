// Module codegen - the syntax tree -> C (Tasks 28.4 + 28.5, one walk)
//
// The C follows what the Python compiler writes for the same program with the shared
// run-time header (runtime/fusion_runtime.h, 28.1.3): the settings, the #include, then the
// program's own code.

import lexer.StrPart
import parser
import parser.Node
import parser.TypeRef

// ---------------------------------------------------------------- C text

// Text as the inside of a C string literal
string function cText(string text) {
    string s = replace(text, "\\", "\\\\")
    s = replace(s, "\"", "\\\"")
    s = replace(s, "\n", "\\n")
    s = replace(s, "\t", "\\t")
    s = replace(s, "\r", "\\r")
    return s
}

// Text as part of a printf format: % doubled as well
string function cFormat(string text) : replace(cText(text), "%", "%%")

string function indent(int depth) : repeat("    ", depth)

// ---------------------------------------------------------------- statements

// print(...) with only text in it (slice 1)
List<string>, Error function genPrint(List<Node> args, int depth) {
    if args.len() != 1 {
        return Error("print with values comes in a later slice")
    }
    match args[0] {
        case Str(parts, line) {
            string text = ""
            for p in parts {
                if p.kind != 0 {
                    return Error("{line}: interpolation comes in a later slice")
                }
                text = text + p.text
            }
            return [indent(depth) + "printf(\"" + cFormat(text) + "\\n\");"]
        }
        else {
            return Error("print needs text")
        }
    }
}

List<string>, Error function genStatement(Node s, int depth, bool isMain) {
    match s {
        case ExprStmt(expr, line) {
            match expr {
                case Call(callee, args, callLine) {
                    match callee {
                        case Name(name, nameLine) {
                            if name == "print" {
                                return genPrint(args, depth)
                            }
                            return Error("{line}: calls come in a later slice")
                        }
                        else {
                            return Error("{line}: calls come in a later slice")
                        }
                    }
                }
                else {
                    return Error("{line}: this statement comes in a later slice")
                }
            }
        }
        case Return(value, line) {
            if isMain {
                return [indent(depth) + "return 0;"]
            }
            return [indent(depth) + "return;"]
        }
        else {
            return Error("this statement comes in a later slice")
        }
    }
}

// ---------------------------------------------------------------- declarations

List<string>, Error function genFunction(Node f) {
    match f {
        case Function(name, result, params, body, line) {
            if name != "main" {
                return Error("{line}: functions other than main come in a later slice")
            }
            List<string> out = ["int main(int argc, char** argv) \{", "    fusion_init(argc, argv);"]
            match body {
                case Block(statements) {
                    for s in statements {
                        List<string> lines = genStatement(s, 1, true)
                        for l in lines {
                            out.add(l)
                        }
                    }
                }
                else {
                    return Error("{line}: a function body must be a block")
                }
            }
            out.add("    return 0;")
            out.add("\}")
            return out
        }
        else {
            return Error("not a function")
        }
    }
}

public string, Error function generate(Node program) {
    List<string> out = ["#include \"fusion_runtime.h\"", "", "// Forward declarations", "int main(int argc, char** argv);", ""]
    match program {
        case Program(decls) {
            for d in decls {
                List<string> lines = genFunction(d)
                for l in lines {
                    out.add(l)
                }
            }
        }
        else {
            return Error("not a program")
        }
    }
    return out.join("\n") + "\n"
}
