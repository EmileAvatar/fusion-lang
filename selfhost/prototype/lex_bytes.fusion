// Task 28.1.2 prototype, pattern B: the source is a read-only parameter (not copied), a
// function returns one token, and the caller collects the tokens.
struct Token
    int kind
    int start
    int stop

int function kindOf(int c)
    if c == 32 or c == 9 or c == 13
        return 0
    if c == 10
        return 4
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
        return 1
    if c >= 48 and c <= 57
        return 2
    if c == 34
        return 3
    return 5

Token function nextToken(bytes data, int pos)
    int n = len(data)
    int k = kindOf(data[pos])
    int stop = pos + 1
    if k == 1 or k == 2
        while stop < n and kindOf(data[stop]) >= 1 and kindOf(data[stop]) <= 2
            stop = stop + 1
    else if k == 3
        while stop < n and data[stop] != 34
            stop = stop + 1
        if stop < n
            stop = stop + 1
    else if k == 0
        while stop < n and kindOf(data[stop]) == 0
            stop = stop + 1
    return Token(k, pos, stop)

void function main(string... args)
    bytes data = readBytes(args[0])
    List<Token> tokens = []
    int pos = 0
    int n = len(data)
    while pos < n
        Token t = nextToken(data, pos)
        if t.kind != 0
            tokens.add(t)
        pos = t.stop
    print("{@1} tokens", tokens.len())
