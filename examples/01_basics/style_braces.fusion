// The same program in three block styles - braces (Task 27.4)
enum Shape: SQUARE CIRCLE

struct Item {
    string name
    int size
    Shape shape
}

int function area(Item item) {
    match item.shape {
        case SQUARE {
            return item.size * item.size
        }
        case CIRCLE {
            return 3 * item.size * item.size
        }
    }
}

void function main() {
    List<Item> items = [Item("box", 2, Shape.SQUARE), Item("coin", 1, Shape.CIRCLE)]
    int total = 0
    for item in items {
        if area(item) > 3 {
            print("{item.name}: big")
        } else {
            print("{item.name}: small")
        }
        total = total + area(item)
    }
    int countdown = 3
    while countdown > 0 {
        countdown = countdown - 1
    }
    print("total {total}, countdown {countdown}")
}
