string function grade(int score)
    match score
        case 90...100                       // both ends included
            return "A"
        case 80...89, 79
            return "B"
        else
            return "C"

void function main()
    int total = 0
    for i in 1...10                         // 1 to 10 - the same as range(1, 11)
        total = total + i
    print("{total}")                        // 55
    int n = 3
    for i in 0...n - 1                      // any whole-number values
        print("{i}")                        // 0 1 2
    for i in 10...0 step -5                 // a step; a negative one counts down
        print("{i}")                        // 10 5 0
    char c = 'q'
    string kind = match c
        'a'...'z' : "lower"                 // characters too
        'A'...'Z' : "upper"
        else : "other"
    print("{@1} {@2}", grade(95), kind)     // A lower
    // Decimals and money (47.6) - [ranges] decimals = true in fusion.toml
    double last = 0.0
    for x in 0.0...1.0 step 0.1             // each value start + n * step - nothing drifts
        last = x
    print("{@1}", last == 1.0)              // true - adding 0.1 ten times gives 0.9999999999999999
    decimal price = 1.50
    for d in price...2.50 step 0.25         // exact
        print("{d}")                        // 1.50 1.75 2.00 2.25 2.50
    money lo = money(0.00, "ZAR", "R")
    money hi = money(1.00, "ZAR", "R")
    for m in lo...hi step 0.50
        print("{m}")                        // R0.00 R0.50 R1.00
    double t = 0.72
    match t                                 // ranges in a match on a double - a test, never ==
        case 0.0...0.49
            print("low")
        case 0.5...1.0
            print("high")                   // high
        else
            print("out of range")
