// Errors: functions that can fail, capturing, try / catch / finally, throw and built-in
// failures (Task 26.6). Run it with the argument "uncaught" to see an error nobody catches
struct Setting
    string name
    int value

Setting, Error function parseSetting(string line)
    List<string> parts = split(line, "=")
    if parts.len() != 2
        return Error("Not 'name=value': {line}", 1)
    string name = parts[0].trim()
    if name.isEmpty()
        return Error("No name in: {line}", 2)
    int value = toInt(parts[1].trim())         // "12x": a built-in failure - it bubbles up
    return Setting(name, value)

int function total(List<string> lines)
    int sum = 0
    for line in lines
        Setting s = parseSetting(line)         // not captured: an error goes to the caller
        sum = sum + s.value
    return sum

void function main(string... args)
    for line in ["width = 80", "height=24", "depth", "=5", "size = 12x"]
        Setting s, Error err = parseSetting(line)
        if err
            print("skip ({@1}): {err}", err.code)
            continue
        print("{s.name} = {s.value}")

    try
        print("total: {@1}", total(["a=1", "b=2"]))
        print("total: {@1}", total(["a=1", "b=oops"]))
    catch err
        print("total failed: {err}")
    finally
        print("totals done")

    if len(args) > 0 and args[0] == "uncaught"
        throw Error("nobody catches this")     // stops the program: exit code 1
    print("all handled")
