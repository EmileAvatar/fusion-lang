// Errors: functions that can fail, capturing, try / catch / finally, throw, error types and
// built-in failures (Tasks 26.6, 26.13). Run it with the argument "uncaught" to see an error
// nobody catches
struct Setting
    string name
    int value

error SettingError                             // a custom error type (Task 26.9)
    string line

error NoNameError : SettingError
    message = "A setting needs a name"

Setting, Error function parseSetting(string line)
    List<string> parts = split(line, "=")
    if parts.len() != 2
        return SettingError("Not 'name=value'", 1, line)
    string name = parts[0].trim()
    if name.isEmpty()
        return NoNameError(code = 2, line = line)
    int value = toInt(parts[1].trim())         // "12x": a built-in failure - it bubbles up
    return Setting(name, value)

int function total(List<string> lines)
    int sum = 0
    for line in lines
        Setting s = parseSetting(line)         // not captured: an error goes to the caller
        sum = sum + s.value
    return sum

void function main(string... args)
    for line in ["width = 80", "height=24", "depth", "=5", "size = 12x"]
        Setting s, err = parseSetting(line)
        match err                              // on the error's type
            case NoNameError: print("skip ({@1}): {err} - '{err.line}'", err.code)
            case SettingError: print("skip ({@1}): {err}: {err.line}", err.code)
            case NumberFormatError: print("skip: {err.kind}: {err}")
            else: print("{s.name} = {s.value}")

    try
        print("total: {@1}", total(["a=1", "b=2"]))
        print("total: {@1}", total(["a=1", "b=oops"]))
    catch SettingError err                     // typed catches: the first that matches
        print("bad setting: {err}")
    catch err
        print("total failed: {err.kind}: {err}")
    finally
        print("totals done")

    int zero = 0
    try
        print("{@1}", readText("no_such_settings.txt"))
    catch FileNotFoundError err                // Fusion's own error types (Task 26.12)
        print("{err.kind}: {err.path}")
    try
        print("{@1}", 10 / zero)
    catch ArithmeticError err
        print("{err.kind}: {err}")

    if len(args) > 0 and args[0] == "uncaught"
        throw Error("nobody catches this")     // stops the program: exit code 1
    print("all handled")
