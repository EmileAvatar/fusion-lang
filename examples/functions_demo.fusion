// Fusion Functions Demo (Task 18.1)
// Demonstrates parameter default values, array parameters, and lambdas

// Parameters with defaults must come last, and each default must be a constant
void function greet(string name = "World", string greeting = "Hello")
    print("{greeting}, {name}!")
End function

int function offset(int value, int by = -5) : value + by

// int[] accepts an array of any size - len() gives its actual length
int function sum(int[] values)
    int total = 0
    for i in range(0, len(values))
        total = total + values[i]
    End for
    return total
End function

// Arrays are passed by reference: changes made here are seen by the caller
void function doubleAll(int[] values)
    for i in range(0, len(values))
        values[i] = values[i] * 2
    End for
End function

// int[3] accepts only an array of exactly 3 elements (checked at compile time)
int function middle(int[3] trio) : trio[1]

int function triple(int x) : x * 3

// A parameter that holds a function: (int) : int means "takes an int, returns an int"
int function apply((int) : int operation, int value) : operation(value)

void function main()
    print("=== Fusion Functions Demo ===")

    // Default parameter values - omitted arguments use the declared default
    greet()
    greet("Fusion")
    greet("Fusion", "Welcome")

    int lower = offset(10)
    int higher = offset(10, 2)
    print("offset(10) = {lower}, offset(10, 2) = {higher}")

    // Array parameters
    int[] small = [1, 2, 3]
    int[] large = [10, 20, 30, 40, 50]
    int smallSum = sum(small)
    int largeSum = sum(large)
    int literalSum = sum([7, 8])
    print("sum: {smallSum}, {largeSum}, {literalSum}")

    doubleAll(small)
    int mid = middle(small)
    print("After doubleAll, middle of small = {mid}")

    // Lambdas and function values
    (int) : int op = triple
    int tripled = op(5)
    op = func(int x) : x + 100
    int added = op(5)
    int squared = apply(func(int x) : x * x, 7)
    int viaName = apply(triple, 7)
    print("tripled = {tripled}, added = {added}, squared = {squared}, viaName = {viaName}")

    print("All function tests passed!")
End function
