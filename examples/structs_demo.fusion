// Fusion Structs Demo (Task 18.2)
// Structs are pure value types: fields only - behaviour lives in ordinary functions.
// Also shows named arguments (Task 18.2.2), {@N} placeholders (18.2.2b), nesting (18.2.3)
// and functions returning arrays (18.2.4)

// Indentation style
struct Point
    int x
    int y

// Braces style, with field defaults
struct Player {
    string name
    float health = 100.0
    int score
}

// End keyword style
struct Book
    string title
    bool available = true
End struct

// Structs are passed and returned by value (a copy)
Point function add(Point a, Point b)
    return Point(a.x + b.x, a.y + b.y)
End function

// Changes the function's own copy - the caller's struct is untouched
void function moveRight(Point p)
    p.x = p.x + 100
    print("Inside moveRight: x = {p.x}")
End function

// Nesting (Task 18.2.3): a struct can hold other structs and fixed-size arrays
struct Rect
    Point min
    Point max
    string label = "box"

struct Team
    string name
    int[3] scores
    Point[2] positions

// Arrays (including arrays of structs) are passed by reference
void function nudge(Point[] points)
    for i in range(0, len(points))
        points[i].x = points[i].x + 1
    End for
End function

// Functions can return fixed-size arrays (Task 18.2.4) - the size is part of the type
Point[2] function diagonal(int size)
    return [Point(0, 0), Point(size, size)]
End function

int function total(int[] values)
    int sum = 0
    for i in range(0, len(values))
        sum = sum + values[i]
    End for
    return sum
End function

void function main()
    // The compiler-generated constructor takes the fields in declaration order
    Point a = Point(3, 4)

    // Assigning copies the whole struct
    Point b = a
    b.x = 10
    print("a = ({a.x}, {a.y}), b = ({b.x}, {b.y})")

    Point sum = add(a, b)
    print("a + b = ({sum.x}, {sum.y})")

    moveRight(a)
    print("After moveRight: a.x = {a.x}")

    // Fields with defaults can be left off the end; a struct declared without a value
    // starts with every field at its default, or zero
    Player ada = Player("Ada", 75, 10)
    ada.score = ada.score + 5
    print("{ada.name}: health {ada.health}, score {ada.score}")
    Player newcomer
    print("Newcomer score: {newcomer.score}, health {newcomer.health}")

    // String fields can be changed
    Book book = Book("Dune")
    book.title = "Dune Messiah"
    if book.available
        print("{book.title} is available")
    End if

    const Point ORIGIN = Point(0, 0)
    print("Origin: ({ORIGIN.x}, {ORIGIN.y})")

    // Named arguments: any order, and any field with a default can be skipped
    Point named = Point(y = 8, x = 7)
    print("Named point: ({named.x}, {named.y})")
    Player scorer = Player(score = 42, name = "Linus")
    print("{scorer.name}: health {scorer.health}, score {scorer.score}")

    // Named arguments work for function calls too
    Point shifted = add(b = Point(1, 1), a = named)
    print("Shifted: ({shifted.x}, {shifted.y})")

    // Positional placeholders (Task 18.2.2b): {@N} is print's Nth argument after the text,
    // in any order and as often as needed
    print("{@2} ({@3}) beat {@1} ({@4})", ada.name, scorer.name, scorer.score, ada.score)

    // Nested structs: copying a Rect copies the Points inside it too
    Rect box = Rect(Point(0, 0), Point(4, 3))
    Rect bigger = box
    bigger.max.x = 40
    print("{box.label}: max.x = {box.max.x}, bigger max.x = {bigger.max.x}")

    // Array fields start zeroed; arrays of structs can be passed to functions
    Team team = Team("Blue", [3, 5, 7])
    team.scores[0] = 10
    nudge(team.positions)
    print("{team.name} total {@1}, first position x = {@2}", total(team.scores), team.positions[0].x)

    // A returned array can be stored, assigned to an array, or indexed directly
    Point[2] ends = diagonal(9)
    team.positions = diagonal(2)
    print("Diagonal ends at ({@1}, {@2}); team now at x = {@3}; diagonal(4)[1].y = {@4}", ends[1].x, ends[1].y, team.positions[1].x, diagonal(4)[1].y)
    print("All struct tests passed!")
End function
