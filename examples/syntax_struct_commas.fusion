struct Point { int x, int y }             // on one line: commas between the fields

struct Size
    int w                                 // on new lines: no comma needed
    int h

void function main()
    Point p = Point(1, 2)
    Size s = Size(3, 4)
    print("{@1} {@2} {@3}", p.x + p.y, s.w, s.h)
