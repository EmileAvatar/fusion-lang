{
  "project": {
    "name": "MyFusionProject",
    "version": "1.0.0",
    "description": "A Fusion language project",
    "author": "Your Name",
    "license": "MIT",
    "fusionVersion": "1.0.0",
    "projectType": "application",
    "createdDate": "2025-01-15T10:00:00Z",
    "modifiedDate": "2025-01-15T10:00:00Z"
  },
  
  "build": {
    "outputDirectory": "./build",
    "targetPlatform": "windows-x64",
    "buildType": "release",
    "optimization": "speed",
    "enableDebugSymbols": false,
    "generateDocumentation": true,
    "compressionLevel": "medium",
    "customBuildSteps": []
  },
  
  "compiler": {
    "strictMode": true,
    "unsafeMode": false,
    "warningsAsErrors": false,
    "maxWarnings": 100,
    "optimizationLevel": 2,
    "targetCPU": "x64",
    "enableInlining": true,
    "enableDeadCodeElimination": true,
    "parallelCompilation": true,
    "maxParallelJobs": 4
  },
  
  "language": {
    "allowWeakPointers": false,
    "allowGoto": false,
    "enforceNullChecks": true,
    "requireExplicitTypes": false,
    "allowImplicitCasts": true,
    "maxFunctionLength": 500,
    "maxClassComplexity": 100,
    "enforceCodingStandards": true
  },
  
  "loop": {
    "autoProtection": true,
    "defaultMaxIterations": 1000000,
    "enableThreadInterrupts": true,
    "enableResourceMonitoring": true,
    "adaptToSystemResources": true,
    "resourceCheckInterval": 100
  },
  
  "memory": {
    "defaultMode": "gc",
    "enableSmartPointers": true,
    "enableRawPointers": false,
    "gcAlgorithm": "generational",
    "gcMaxHeapSize": "512MB",
    "gcThreads": 2,
    "enableMemoryProfiler": false
  },
  
  "threading": {
    "enableChannels": true,
    "enableSharedMemory": true,
    "enableAutoLocking": true,
    "maxThreads": 8,
    "threadPoolSize": 4,
    "enableRaceDetection": true,
    "enableDeadlockDetection": true,
    "defaultThreadStackSize": "1MB"
  },
  
  "modules": {
    "searchPaths": [
      "./modules",
      "./lib",
      "${FUSION_HOME}/stdlib"
    ],
    "autoImport": [
      "Fusion.Core",
      "Fusion.Collections"
    ],
    "allowCircularDependencies": false,
    "enableModuleCaching": true
  },
  
  "standardLibrary": {
    "includeAll": true,
    "fileFormats": {
      "json": true,
      "xml": true,
      "csv": true,
      "yaml": true,
      "ini": true,
      "md": true,
      "txt": true
    },
    "imageFormats": {
      "png": true,
      "jpeg": true,
      "bmp": true,
      "gif": true
    },
    "binaryFormats": {
      "pdf": true,
      "docx": true,
      "xlsx": true,
      "zip": true
    },
    "languages": {
      "fusion": true,
      "java": false,
      "cpp": false,
      "go": false,
      "javascript": false,
      "python": false
    },
    "networking": true,
    "graphics": true,
    "audio": true,
    "localization": true
  },
  
  "codegen": {
    "indentStyle": "spaces",
    "indentSize": 4,
    "lineEndings": "lf",
    "insertFinalNewline": true,
    "trimTrailingWhitespace": true,
    "maxLineLength": 120,
    "allowBraces": true,
    "preferredBraceStyle": "indentation"
  },
  
  "syntax": {
    "commentStyle": "doubleSlash",
    "enumStyle": "auto",
    "allowSpreadOperator": true,
    "allowVariadicFunctions": true,
    "comparisonOperator": "both",
    "enforceEndLoop": true
  },
  
  "testing": {
    "testDirectory": "./tests",
    "enableUnitTests": true,
    "enableIntegrationTests": true,
    "coverageThreshold": 80,
    "parallelTests": true,
    "testTimeout": 30000
  },
  
  "documentation": {
    "generateDocs": true,
    "outputDirectory": "./docs",
    "format": "html",
    "includePrivateMembers": false,
    "includeSourceCode": false,
    "theme": "default"
  },
  
  "dependencies": {
    "packages": {},
    "devPackages": {}
  },
  
  "scripts": {
    "preBuild": "",
    "postBuild": "",
    "preTest": "",
    "postTest": "",
    "deploy": ""
  },
  
  "annotations": {
    "customAnnotations": {
      "@Performance": {
        "enabled": true,
        "description": "Marks performance-critical code"
      },
      "@Deprecated": {
        "enabled": true,
        "description": "Marks deprecated code"
      },
      "@Unsafe": {
        "enabled": false,
        "description": "Marks unsafe code blocks"
      },
      "@NoOptimize": {
        "enabled": true,
        "description": "Prevents compiler optimization"
      }
    }
  }
}
