{
  "about": "Fusion's colours (Task 36.8) - change a colour here, then run: python tools/editors/build_grammar.py --vsix. Every colour must reach WCAG AA contrast (4.5:1) on its palette's background - tests/test_editor_grammar.py checks it. style: bold / italic / underline - so a piece is told apart by more than its colour.",
  "roles": {
    "keyword":       {"scopes": ["keyword.control", "keyword.operator.word"], "site": "kw"},
    "declaration":   {"scopes": ["storage.type"]},
    "modifier":      {"scopes": ["storage.modifier"]},
    "type":          {"scopes": ["support.type.primitive", "support.class.builtin", "entity.name.type"], "site": "type"},
    "function":      {"scopes": ["entity.name.function", "entity.name.function.call"], "site": "fn"},
    "string":        {"scopes": ["string.quoted"], "site": "str"},
    "escape":        {"scopes": ["constant.character.escape"]},
    "interpolation": {"scopes": ["meta.interpolation", "punctuation.section.interpolation", "variable.other.interpolated"]},
    "number":        {"scopes": ["constant.numeric"], "site": "num"},
    "comment":       {"scopes": ["comment"], "site": "com"},
    "operator":      {"scopes": ["keyword.operator"], "site": "op"},
    "literal":       {"scopes": ["constant.language"]},
    "this":          {"scopes": ["variable.language"]},
    "reserved":      {"scopes": ["keyword.other.reserved"]}
  },
