{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*//\\s*region\\b",
      "end": "^\\s*//\\s*endregion\\b"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|\\d[\\d_]*(\\.\\d[\\d_]*)?",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((if|else|while|for|foreach|loop|try|catch|finally|match|fall match|case|class|struct|interface|enum|Enum|constructor|service)\\b[^:]*|.*\\bfunction\\s+[A-Za-z_][A-Za-z0-9_<>, ]*\\([^)]*\\)\\s*|.*\\{\\s*)$",
    "decreaseIndentPattern": "^\\s*(\\}|End\\b|end\\b)"
  }
}
