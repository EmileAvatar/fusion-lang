{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fusion",
  "scopeName": "source.fusion",
  "fileTypes": [
    "fusion"
  ],
  "comment": "Written by tools/editors/build_grammar.py from src/lexer/keywords.py - do not edit by hand",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.fusion",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.fusion",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fusion",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fusion",
              "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|.)"
            },
            {
              "name": "meta.interpolation.fusion",
              "match": "(\\{)(@\\d+|[^{}\"]+)(\\})",
              "captures": {
                "1": {
                  "name": "punctuation.section.interpolation.begin.fusion"
                },
                "2": {
                  "name": "variable.other.interpolated.fusion"
                },
                "3": {
                  "name": "punctuation.section.interpolation.end.fusion"
                }
              }
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.fusion",
          "match": "'(\\\\(u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|.)|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.fusion",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.fusion",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.fusion",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.fusion",
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*([eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*)(dec|[mfFdD])?\\b"
        },
        {
          "name": "constant.numeric.decimal.fusion",
          "match": "\\b\\d[\\d_]*(dec|m)\\b"
        },
        {
          "name": "constant.numeric.integer.fusion",
          "match": "\\b\\d[\\d_]*[Ll]?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(function|func)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.function.fusion"
            },
            "2": {
              "name": "entity.name.function.fusion"
            }
          }
        },
        {
          "match": "\\b(class|struct|interface|enum|Enum)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.class.fusion"
            },
            "2": {
              "name": "entity.name.type.fusion"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fusion",
          "match": "(?<![\\w.])\\b(continue|finally|foreach|return|async|await|break|catch|match|throw|while|case|else|fall|loop|step|End|end|for|try|go|if)\\b"
        },
        {
          "name": "storage.type.fusion",
          "match": "(?<![\\w.])\\b(constructor|implements|interface|namespace|function|includes|inherits|property|template|extends|import|module|struct|class|Enum|cast|enum|func|get|new|set)\\b"
        },
        {
          "name": "storage.modifier.fusion",
          "match": "(?<![\\w.])\\b(protected|abstract|internal|override|readonly|noshare|private|service|virtual|Shared|nocopy|public|sealed|static|byRef|byVal|const|fixed|Weak|let|var)\\b"
        },
        {
          "name": "keyword.operator.word.fusion",
          "match": "(?<![\\w.])\\b(and|not|in|is|or)\\b"
        },
        {
          "name": "constant.language.fusion",
          "match": "(?<![\\w.])\\b(false|null|true)\\b"
        },
        {
          "name": "variable.language.fusion",
          "match": "(?<![\\w.])\\b(super|this)\\b"
        },
        {
          "name": "keyword.other.reserved.fusion",
          "match": "(?<![\\w.])\\b(synchronized|transaction|comptime|operator|volatile|channel|default|hotpath|assert|atomic|choice|delete|export|extern|nameof|record|select|sizeof|switch|typeof|unsafe|check|defer|macro|trait|union|using|where|yield|base|elif|goto|impl|lock|move|self|type|mut|out|ref)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.fusion",
          "match": "(?<![\\w.])\\b(double|int128|int256|string|float|short|bool|byte|char|long|void|int)\\b"
        },
        {
          "name": "support.class.builtin.fusion",
          "match": "(?<![\\w.])\\b(Collection|Dictionary|Cloneable|Iterator|Rounding|Default|decimal|Number|Entry|Error|bytes|money|List|Map)\\b"
        },
        {
          "name": "entity.name.type.fusion",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.fusion"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.fusion",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.null.fusion",
          "match": "\\?\\.|\\?\\?"
        },
        {
          "name": "keyword.operator.comparison.fusion",
          "match": "===|!==|==|!=|<=|>="
        },
        {
          "name": "keyword.operator.arrow.fusion",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.fusion",
          "match": "[-+*/%=<>!&|^~?:]"
        }
      ]
    }
  }
}
